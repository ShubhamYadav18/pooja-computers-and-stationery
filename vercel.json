{
  "version": 2,
  "redirects": [
    {
      "source": "/sitemap.html",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/sitemap",
      "destination": "/sitemap.xml",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ]
}

